# 🔐 Variables de Entorno - Lucky Snap Backend
# Copia este archivo a .env y rellena con tus valores reales

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://user:password@host:port/database

# Configuración del Servidor
NODE_ENV=development
PORT=3000

# Seguridad
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# CORS (URLs permitidas separadas por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,https://yourdomain.netlify.app

# Cloudinary (opcional - para subida de imágenes)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Debe ser un "Unsigned Upload Preset" existente en tu Cloudinary
CLOUDINARY_UPLOAD_PRESET=lucky_snap_preset
# (Opcional) Carpeta en Cloudinary (sí puede usar "/" si quieres subcarpetas)
CLOUDINARY_FOLDER=luckysnap

# PayPal (para pagos automáticos)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
# Tasa de cambio HNL a USD (ajustar según tasa actual)
PAYPAL_EXCHANGE_RATE=24.7
# URL del frontend (para redirects después del pago)
FRONTEND_URL=http://localhost:5173

# ROKI Connect (pago con tarjeta, checkout alojado). Ver docs/ROKI_SETUP.md
# Secretos SOLO en el servidor: nunca en el frontend (VITE_*), ni en Git, ni en logs.
ROKI_ENABLED=false
# sandbox | live  (la llave debe coincidir: sk_test_* para sandbox, sk_live_* para live)
ROKI_ENVIRONMENT=sandbox
ROKI_SECRET_KEY=
# Secreto de firma del endpoint de webhook (whsec_*), uno por entorno
ROKI_WEBHOOK_SECRET=
# ISO 4217 numérico: 340 = Lempira (HNL)
ROKI_CURRENCY_CODE=340
# true muestra "Tarjeta" en la tienda; con false solo funcionan los enlaces por folio (prueba controlada)
ROKI_PUBLIC_CHECKOUT=false
# receipt: comprobante + página del backend (tienda actual) · result: /#/pago (rediseño)
ROKI_RETURN_PAGE=result
# Origen público del frontend (success_url / cancel_url) y del backend (URL del webhook)
PUBLIC_APP_URL=https://luckysnaphn.com
PUBLIC_API_URL=https://luckysnapv6-production.up.railway.app
# Opcionales
# ROKI_WEBHOOK_TOLERANCE_SECONDS=300
# ROKI_RECONCILE_INTERVAL_SECONDS=120
# ROKI_MIN_MINUTES_BEFORE_EXPIRY=5
# ROKI_API_BASE_URL=https://aura.roki.systems/api/connect/v1

# Render (opcional - para deployment)
RENDER_DEPLOY_HOOK=your_render_deploy_hook_url
