// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  district  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
  orders  Order[]

  @@map("users")
}

model Raffle {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  gallery     Json?    // Array de imágenes
  price       Float    @default(50.0)
  tickets     Int
  sold        Int      @default(0)
  drawDate    DateTime
  status      String   @default("draft")
  slug        String?  @unique
  boletosConOportunidades Boolean  @default(false)
  numeroOportunidades    Int      @default(1)
  giftTickets            Int?     @default(0)
  packs       Json?    // Array de paquetes [{name, tickets/q, price}]
  bonuses     String[] // Array de bonos/premios adicionales
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticketOrders Ticket[]
  orders  Order[]

  @@map("raffles")
}

model Ticket {
  id        String   @id @default(cuid())
  raffleId  String
  userId    String
  quantity  Int
  createdAt DateTime @default(now())

  raffle Raffle @relation(fields: [raffleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("tickets")
}

model Order {
  id           String      @id @default(cuid())
  folio        String      @unique
  raffleId     String
  userId       String
  tickets      Int[]
  total        Float
  status       OrderStatus @default(PENDING)
  paymentMethod String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  expiresAt    DateTime

  raffle Raffle @relation(fields: [raffleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  payments Payment[]

  @@map("orders")
}

model Winner {
  id          String   @id @default(cuid())
  name        String
  prize       String
  imageUrl    String
  raffleTitle String
  drawDate    DateTime
  ticketNumber Int?
  testimonial String?
  phone       String?
  city        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("winners")
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String?
  password  String
  role      String   @default("ventas")  // superadmin, admin, ventas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model Settings {
  id              String   @id @default(cuid())
  siteName        String   @default("Lucky Snap")
  
  // Appearance settings
  logo            String?
  favicon         String?
  logoAnimation   String   @default("rotate")
  primaryColor    String   @default("#111827")
  secondaryColor  String   @default("#1f2937")
  accentColor     String   @default("#ec4899")
  actionColor     String   @default("#0ea5e9")
  
  // Contact info
  whatsapp        String?
  email           String?
  
  // Email customization
  emailFromName   String?   // Nombre del remitente en emails
  emailReplyTo    String?   // Email de respuesta
  emailSubject    String?   // Asunto por defecto para emails
  
  // Social links
  facebookUrl     String?
  instagramUrl    String?
  tiktokUrl       String?
  
  // Other settings
  paymentAccounts Json?
  faqs            Json?
  displayPreferences Json?
  orderExpirationMinutes Int      @default(1440)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("settings")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  RELEASED
}

// ─────────────────────────────────────────────────────────────────────────────
// Pagos con pasarela (ROKI Connect). El estado financiero vive aquí; la
// asignación de boletos sigue siendo Order.status. Un pedido puede tener varios
// intentos (p. ej. el primero expiró), pero solo uno puede confirmarlo.
// ─────────────────────────────────────────────────────────────────────────────
model Payment {
  id                String    @id @default(cuid())
  orderId           String
  provider          String    @default("roki")
  environment       String                        // sandbox | live
  merchantId        String?                       // id devuelto por GET /me al crear el pago
  status            String    @default("pending") // pending | paid | failed | expired | voided | refunded | partially_refunded | disabled
  providerPaymentId Int?                          // Payment.id de ROKI
  transactionId     String?                       // UUID del cobro (null hasta que se paga)
  externalReference String                        // folio del pedido enviado como external_reference
  idempotencyKey    String    @unique
  amountExpected    Float
  currencyCode      String                        // ISO 4217 numérico ("340" = HNL)
  currencyIso       String                        // "HNL"
  amountConfirmed   Float?
  checkoutUrl       String?
  requestSnapshot   Json                          // cuerpo exacto enviado a POST /payments
  providerSnapshot  Json?                         // último objeto Payment recibido del proveedor
  expiresAt         DateTime?                     // expires_at del enlace de pago
  paidAt            DateTime?                     // paid_at reportado por el proveedor
  confirmedAt       DateTime?                     // momento en que este pago confirmó el pedido
  lastCheckedAt     DateTime?
  nextCheckAt       DateTime?
  checkCount        Int       @default(0)
  failureCount      Int       @default(0)
  reviewReason      String?                       // incidencia pendiente (pago tardío, importe distinto, etc.)
  reviewDetails     Json?
  reviewResolvedAt  DateTime?
  reviewResolution  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]

  @@unique([provider, environment, providerPaymentId])
  @@index([orderId])
  @@index([status, nextCheckAt])
  @@index([reviewReason, reviewResolvedAt])
  @@map("payments")
}

// Bandeja duradera de webhooks: se guarda antes de responder 2xx y se procesa
// después. La unicidad por evento hace idempotentes los reintentos del proveedor.
model PaymentEvent {
  id                String    @id @default(cuid())
  provider          String    @default("roki")
  environment       String
  eventId           String
  eventType         String
  providerPaymentId Int?
  paymentId         String?
  rawBody           String
  headers           Json?
  status            String    @default("received") // received | processed | ignored | failed
  error             String?
  attempts          Int       @default(0)
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, environment, eventId])
  @@index([status, receivedAt])
  @@map("payment_events")
}